---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
import * as m from "../paraglide/messages.js";
---

<BaseLayout title={m.thanks_title()}>
  <section class="screen thanks">
    <Logo size={64} />
    <h1 class="display">{m.thanks_heading()}</h1>
    <p>{m.thanks_text()}</p>
    <p class="cta-row"><a class="btn" href="/">{m.thanks_home()}</a></p>
  </section>
</BaseLayout>
