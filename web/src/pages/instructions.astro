---
import BaseLayout from "../layouts/BaseLayout.astro";
import * as m from "../paraglide/messages.js";

const steps = [
  [m.how_step_listen_title(), m.how_step_listen_text()],
  [m.how_step_answer_title(), m.how_step_answer_text()],
  [m.how_step_profile_title(), m.how_step_profile_text()],
];
---

<BaseLayout title={m.how_title()}>
  <p class="eyebrow">{m.how_title()}</p>
  <h1 class="display page-title">{m.how_heading()}</h1>
  <ol class="how-steps">
    {steps.map(([title, text], i) => (
      <li class="screen how-step">
        <span class="how-num display" aria-hidden="true">{i + 1}</span>
        <div>
          <h2>{title}</h2>
          <p>{text}</p>
        </div>
      </li>
    ))}
  </ol>
  <aside class="note">
    <h2>{m.how_note_title()}</h2>
    <p>{m.how_note_text()}</p>
  </aside>
  <p class="cta-row"><a class="btn" href="/survey">{m.how_start()}</a></p>
</BaseLayout>
