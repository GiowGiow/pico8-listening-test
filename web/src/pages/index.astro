---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroPattern from "../components/HeroPattern.astro";
import StartForm from "../components/StartForm";
import { PAIRS_PER_PARTICIPANT } from "../lib/api";
import * as m from "../paraglide/messages.js";
---

<BaseLayout title={m.home_title()}>
  <section class="hero">
    <p class="eyebrow">{m.home_eyebrow()}</p>
    <h1 class="display hero-title">{m.home_hero_title()}</h1>
    <p class="hero-text">{m.home_hero_text()}</p>
    <HeroPattern />
    <p class="facts mono">
      <span>{m.home_facts_pairs({ count: PAIRS_PER_PARTICIPANT })} {m.home_facts_pairs_detail()}</span>
      <span>{m.home_facts_time()} {m.home_facts_time_detail()}</span>
      <span>{m.home_facts_headphones()}: {m.home_facts_headphones_detail()}</span>
    </p>
  </section>

  <section class="screen start" aria-labelledby="start-title">
    <h2 id="start-title">{m.home_start_title()}</h2>
    <StartForm client:load />
  </section>

  <section class="screen" aria-labelledby="about-title">
    <h2 id="about-title">{m.home_about_title()}</h2>
    <p>{m.home_about_text()}</p>
  </section>

  <section class="screen" aria-labelledby="privacy-title">
    <h2 id="privacy-title">{m.home_privacy_title()}</h2>
    <p>{m.home_privacy_text()}</p>
  </section>
</BaseLayout>
