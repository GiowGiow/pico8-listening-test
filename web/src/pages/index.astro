---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailRegistrationComponent from '../components/EmailRegistrationComponent';
import { studyConfig } from '../config/studyConfig.js';
import * as m from "../paraglide/messages.js";
---

<BaseLayout title={m.index_title()}>
    <section class="max-w-4xl mx-auto py-12">
        <!-- Hero Section -->
        <div class="text-center mb-16">
            <h1 class="text-5xl font-bold mb-6 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
                {m.index_hero_title()}
            </h1>
            <p class="text-xl text-gray-600 mb-8"> 
                {m.index_hero_subtitle()}
            </p>
        </div>

        <!-- Welcome Card -->
        <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
            <div class="flex items-center mb-6">
                <div class="flex-shrink-0">
                    <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
                        </svg>
                    </div>
                </div>
                <div class="ml-4">
                    <h2 class="text-2xl font-semibold text-gray-800">{m.index_welcome_card_title()}</h2>
                    <p class="text-gray-600">{m.index_welcome_card_subtitle()}</p>
                </div>
            </div>

            <p class="text-lg text-gray-700 leading-relaxed mb-6" set:html={m.index_welcome_card_text()} />

            <div class="bg-blue-50 border-l-4 border-blue-400 p-6 mb-6">
                <h3 class="text-lg font-semibold text-blue-900 mb-2">{m.index_research_goal_title()}</h3>
                <p class="text-blue-800">
                    {m.index_research_goal_text()}
                </p>
            </div>

            <div class="bg-amber-50 border-l-4 border-amber-400 p-6 mb-6">
                <h3 class="text-lg font-semibold text-amber-900 mb-2">{m.index_email_collection_title()}</h3>
                <p class="text-amber-800" set:html={m.index_email_collection_text()} />
            </div>
        </div>

        <!-- What to Expect -->
        <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
            <h3 class="text-2xl font-semibold mb-6 text-gray-800 border-b border-gray-200 pb-3">
                {m.index_what_to_expect_title()}
            </h3>
            <div class="grid md:grid-cols-2 gap-8">
                <div class="text-center p-6">
                    <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15.536a5 5 0 001.414 1.414m2.828-9.9a9 9 0 012.829 0"></path>
                        </svg>
                    </div>
                    <h4 class="text-lg font-semibold mb-2">{m.index_what_to_expect_audio_title()}</h4>
                    <p class="text-gray-600">{m.index_what_to_expect_audio_text({ numberOfPairs: studyConfig.numberOfPairs })}</p>
                </div>
                <div class="text-center p-6">
                    <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                        </svg>
                    </div>
                    <h4 class="text-lg font-semibold mb-2">{m.index_what_to_expect_anonymous_title()}</h4>
                    <p class="text-gray-600">{m.index_what_to_expect_anonymous_text()}</p>
                </div>
            </div>
        </div>

        <!-- Call to Action -->
        <EmailRegistrationComponent client:load />
    </section>
</BaseLayout>