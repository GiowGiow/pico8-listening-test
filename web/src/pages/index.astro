---
import BaseLayout from "../layouts/BaseLayout.astro";
import StartForm from "../components/StartForm";
import { PAIRS_PER_PARTICIPANT } from "../lib/api";
import * as m from "../paraglide/messages.js";
---

<BaseLayout title={m.home_title()}>
  <section class="hero">
    <p class="eyebrow">{m.home_eyebrow()}</p>
    <h1 class="hero-title gradient">{m.home_hero_title()}</h1>
    <p class="hero-text">{m.home_hero_text()}</p>
  </section>

  <section class="screen" aria-labelledby="start-title">
    <h2 id="start-title">{m.home_start_title()}</h2>
    <StartForm client:load />
  </section>

  <section class="screen" aria-labelledby="expect-title">
    <h2 id="expect-title">{m.home_expect_title()}</h2>
    <div class="facts">
      <div class="fact">
        <div class="fact-icon" aria-hidden="true">
          <svg fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 19V6l12-3v13M9 19c0 1.1-1.3 2-3 2s-3-.9-3-2 1.3-2 3-2 3 .9 3 2zm12-3c0 1.1-1.3 2-3 2s-3-.9-3-2 1.3-2 3-2 3 .9 3 2zM9 10l12-3" /></svg>
        </div>
        <strong>{m.home_facts_pairs({ count: PAIRS_PER_PARTICIPANT })}</strong>
        <span>{m.home_facts_pairs_detail()}</span>
      </div>
      <div class="fact">
        <div class="fact-icon" aria-hidden="true">
          <svg fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
        </div>
        <strong>{m.home_facts_time()}</strong>
        <span>{m.home_facts_time_detail()}</span>
      </div>
      <div class="fact">
        <div class="fact-icon" aria-hidden="true">
          <svg fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 14v-2a8 8 0 0116 0v2" /><rect x="3" y="14" width="4" height="6" rx="1.5" /><rect x="17" y="14" width="4" height="6" rx="1.5" /></svg>
        </div>
        <strong>{m.home_facts_headphones()}</strong>
        <span>{m.home_facts_headphones_detail()}</span>
      </div>
    </div>
  </section>

  <section class="screen" aria-labelledby="about-title">
    <h2 id="about-title">{m.home_about_title()}</h2>
    <p>{m.home_about_text()}</p>
    <div class="callout amber">
      <h3>{m.home_privacy_title()}</h3>
      <p>{m.home_privacy_text()}</p>
    </div>
  </section>
</BaseLayout>
