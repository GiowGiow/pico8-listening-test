---
// Decorative: two 32-step rows like a tracker pattern, same color for both.
// The lit steps are fixed, not taken from any clip.
const rows = [
  "x..x..x.x...x..xx..x..x.x..x.x..",
  ".x...x.x..xx...x.x...x..xx...x.x",
];
---
<div class="hero-rows" aria-hidden="true">
  {rows.map((row, r) => (
    <div class="hero-row">
      <span class="hero-row-label mono">{r + 1}</span>
      <div class="hero-row-steps">
        {[...row].map((c, i) => <span data-on={c === "x" ? "true" : "false"} data-beat={i % 4 === 0 ? "true" : "false"} />)}
      </div>
    </div>
  ))}
  <span class="hero-q display">?</span>
</div>
