---
import Navbar from '../components/Navbar';
import '../styles/global.css'; // Your global styles
import mosaicLogo from '../assets/mosaic.gif';
import ufmgLogo from '../assets/ufmg.svg';
import { getLocale } from '../paraglide/runtime.js';

const currentPath = Astro.url.pathname;
const currentLocale = getLocale(); // Get the current locale for server-side rendering

export interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang={currentLocale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Humanness Percept</title>
  
  <!-- Tailwind CSS (or your preferred framework) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" />
  
  <!-- Your global styles -->
  <style>
    :root {
      --primary-color: #3b82f6; /* blue-500 */
    }
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    img {
      image-rendering: optimizeQuality;

      /* Safari seems to support, but seems deprecated and does the same thing as the others. */
      image-rendering: -webkit-optimize-contrast;
    }
  </style>
</head>
<body class="bg-gray-50 flex flex-col min-h-screen">
  <!-- Navbar with authentication awareness -->
  <Navbar currentPath={currentPath} client:load />

  <!-- Main content area -->
  <main class="flex-grow container mx-auto px-4 py-8">
    <slot /> <!-- This is where page content will be injected -->
  </main>

  <!-- Footer with logos -->
  <footer class="bg-white border-t border-gray-200 py-5 mt-auto">
    <div class="container mx-auto px-4">
      <div class="flex flex-col items-center justify-center space-y-5 md:flex-row md:space-y-0 md:space-x-10">
        <a href="https://ufmg.br" target="_blank" class="flex flex-col items-center space-y-1.5 hover:opacity-80 transition-opacity">
          <img src="/images/ufmg.svg" alt="UFMG Logo" class="h-12 w-auto" />
          <span class="text-gray-600 text-sm text-center">Universidade Federal de Minas Gerais</span>
        </a>
        <a href="https://dcc.ufmg.br" target="_blank" class="flex flex-col items-center space-y-1.5 hover:opacity-80 transition-opacity">
          <img src="/images/dcc.png" alt="DCC Logo" class="h-12 w-auto" />
          <span class="text-gray-600 text-sm text-center">Departamento de Ciência da Computação</span>
        </a>
        <a href="https://uai.science/" target="_blank" class="flex flex-col items-center space-y-1.5 hover:opacity-80 transition-opacity">
          <img src="/images/uai_logo.png" alt="Mosaic Logo" class="h-12 w-auto" />
          <span class="text-gray-600 text-sm text-center">Uncertainty in Artificial Intelligence Lab</span>
        </a>
        <a href="https://mosaic.dcc.ufmg.br" target="_blank" class="flex flex-col items-center space-y-1.5 hover:opacity-80 transition-opacity">
          <img src="/images/mosaic.gif" alt="Mosaic Logo" class="h-12 w-auto" />
          <span class="text-gray-600 text-sm text-center">Music Oriented Systems and AI for Creativity</span>
        </a>
      </div>
      <div class="text-center mt-4 text-gray-500 text-xs">
        © 2025 Humanness Perception Study - Research Initiative
      </div>
    </div>
  </footer>

  <!-- Client-side hydration scripts -->
  <script is:inline>
    // Handle theme preference if needed
    if (localStorage.getItem('theme') === 'dark' || 
        (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    }
  </script>
</body>
</html>