---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { getLocale, locales } from "../paraglide/runtime.js";
import * as m from "../paraglide/messages.js";

interface Props {
  title: string;
}

const { title } = Astro.props;
const locale = getLocale();
const path = Astro.url.pathname;
const contact = import.meta.env.PUBLIC_CONTACT_EMAIL;
const localeNames: Record<string, string> = { "pt-BR": "PT", en: "EN" };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={m.meta_description()} />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · PICO-8</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{m.skip_to_content()}</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand" aria-label={`PICO-8 · ${m.survey_title()}`}>
          <Logo size={32} />
          <span>PICO-8 <span class="brand-sub">· {m.survey_title()}</span></span>
        </a>
        <nav class="site-nav" aria-label="Principal">
          <a href="/instructions" aria-current={path === "/instructions" ? "page" : undefined}>{m.nav_how()}</a>
          <div class="lang" role="group" aria-label={m.nav_language()}>
            {
              locales.map((l) => (
                <button type="button" class="lang-btn" data-locale={l} aria-pressed={l === locale ? "true" : "false"}>
                  {localeNames[l] ?? l}
                </button>
              ))
            }
          </div>
        </nav>
      </div>
    </header>

    <main id="main" class="page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-logos">
          <a href="https://ufmg.br" target="_blank" rel="noopener noreferrer">
            <img src="/images/ufmg.svg" alt="UFMG" height="40" />
          </a>
          <a href="https://dcc.ufmg.br" target="_blank" rel="noopener noreferrer">
            <img src="/images/dcc.png" alt="DCC/UFMG" height="40" />
          </a>
        </div>
        <p class="footer-course">{m.footer_course()}</p>
        {contact && (
          <p class="footer-small">{m.footer_contact()} <a href={`mailto:${contact}`}>{contact}</a></p>
        )}
        <p class="footer-small">{m.footer_trademark()}</p>
      </div>
    </footer>

    <script>
      import { setLocale } from "../paraglide/runtime.js";
      for (const button of document.querySelectorAll<HTMLButtonElement>(".lang-btn")) {
        button.addEventListener("click", () => setLocale(button.dataset.locale as "pt-BR" | "en"));
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
  }
  .site-header-inner,
  .footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    min-height: 4rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #111827;
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: 600;
  }
  .brand-sub {
    font-weight: 400;
    color: #6b7280;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .site-nav > a {
    color: #6b7280;
    text-decoration: none;
    font-weight: 500;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
  }
  .site-nav > a:hover {
    color: #374151;
    border-color: #d1d5db;
  }
  .site-nav > a[aria-current="page"] {
    color: #2563eb;
    border-color: #3b82f6;
  }
  .lang {
    display: flex;
    border: 1px solid #d1d5db;
    border-radius: 0.4rem;
    overflow: hidden;
  }
  .lang-btn {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.3rem 0.65rem;
    color: #4b5563;
    background: #fff;
    border: 0;
    cursor: pointer;
  }
  .lang-btn[aria-pressed="true"] {
    background: #2563eb;
    color: #fff;
  }
  .site-footer {
    margin-top: auto;
    background: #fff;
    border-top: 1px solid #e5e7eb;
  }
  .footer-inner {
    padding-top: 1.25rem;
    padding-bottom: 1.5rem;
    text-align: center;
  }
  .footer-logos {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2.5rem;
    margin-bottom: 0.9rem;
  }
  .footer-logos img {
    height: 3rem;
    width: auto;
  }
  .footer-logos a:hover {
    opacity: 0.8;
  }
  .footer-course {
    font-size: 0.9rem;
    color: #4b5563;
  }
  .footer-small {
    font-size: 0.78rem;
    color: #6b7280;
    margin-top: 0.35rem;
  }
</style>
