---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { getLocale, locales } from "../paraglide/runtime.js";
import * as m from "../paraglide/messages.js";

interface Props {
  title: string;
}

const { title } = Astro.props;
const locale = getLocale();
const path = Astro.url.pathname;
const contact = import.meta.env.PUBLIC_CONTACT_EMAIL;
const localeNames: Record<string, string> = { "pt-BR": "PT", en: "EN" };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={m.meta_description()} />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#1d2b53" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · PICO-8 Percept</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{m.skip_to_content()}</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand" aria-label="PICO-8 Percept, início">
          <Logo size={36} />
          <span class="brand-word">PICO-8 <span class="brand-accent">Percept</span></span>
        </a>
        <nav class="site-nav" aria-label="Principal">
          <a href="/instructions" aria-current={path === "/instructions" ? "page" : undefined}>{m.nav_how()}</a>
          <div class="lang" role="group" aria-label={m.nav_language()}>
            {
              locales.map((l) => (
                <button type="button" class="lang-btn" data-locale={l} aria-pressed={l === locale ? "true" : "false"}>
                  {localeNames[l] ?? l}
                </button>
              ))
            }
          </div>
        </nav>
      </div>
    </header>

    <main id="main" class="page">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-logos">
          <a href="https://ufmg.br" target="_blank" rel="noopener noreferrer">
            <img src="/images/ufmg.svg" alt="UFMG" height="40" />
          </a>
          <a href="https://dcc.ufmg.br" target="_blank" rel="noopener noreferrer">
            <img src="/images/dcc.png" alt="DCC/UFMG" height="40" />
          </a>
        </div>
        <p class="mono footer-course">{m.footer_course()}</p>
        {contact && (
          <p class="footer-small">{m.footer_contact()} <a href={`mailto:${contact}`}>{contact}</a></p>
        )}
        <p class="footer-small">{m.footer_trademark()}</p>
      </div>
    </footer>

    <script>
      import { setLocale } from "../paraglide/runtime.js";
      for (const button of document.querySelectorAll<HTMLButtonElement>(".lang-btn")) {
        button.addEventListener("click", () => setLocale(button.dataset.locale as "pt-BR" | "en"));
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 2px solid var(--line);
    background: var(--p8-black);
  }
  .site-header-inner,
  .footer-inner {
    max-width: 46rem;
    margin: 0 auto;
    padding: 0.75rem 1rem;
  }
  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }
  .brand-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.03em;
  }
  .brand-accent {
    color: var(--accent);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .site-nav > a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .site-nav > a:hover,
  .site-nav > a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
  }
  .lang {
    display: flex;
    border: 2px solid var(--line);
  }
  .lang-btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.2rem 0.55rem;
    color: var(--ink-soft);
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .lang-btn[aria-pressed="true"] {
    background: var(--ink);
    color: var(--p8-black);
  }
  .site-footer {
    margin-top: auto;
    border-top: 2px solid var(--line);
    background: var(--p8-black);
  }
  .footer-inner {
    padding-top: 1.5rem;
    padding-bottom: 1.75rem;
    text-align: center;
  }
  .footer-logos {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin-bottom: 1rem;
  }
  .footer-logos img {
    height: 40px;
    width: auto;
    background: var(--p8-white);
    padding: 4px 8px;
  }
  .footer-course {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .footer-small {
    font-size: 0.78rem;
    color: var(--p8-lavender);
    margin-top: 0.4rem;
  }
</style>
